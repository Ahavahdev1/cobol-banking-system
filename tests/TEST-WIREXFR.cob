    PERFORM TEST-WR-020
    PERFORM TEST-WR-021
    PERFORM TEST-WR-022
    PERFORM TEST-WR-023
    PERFORM TEST-WR-024
    PERFORM TEST-WR-025
    PERFORM TEST-WR-026
    PERFORM TEST-WR-027
    PERFORM TEST-WR-028
    PERFORM TEST-WR-029
    PERFORM TEST-WR-030
    PERFORM TEST-WR-031
    PERFORM TEST-WR-032
    PERFORM TEST-WR-033

    DISPLAY "========================================".
    DISPLAY "RESULTS: " WS-PASS-COUNT "/" WS-TEST-COUNT
